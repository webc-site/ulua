@import url('https://cdn.jsdmirror.com/npm/18s@0.2.24/_.css')

/* ════════════════════════════════════════════════════════════════════════
   ulua — Minimalist Pure Technical Aesthetic (based on webc style)
   ════════════════════════════════════════════════════════════════════════ */

*, ::before, ::after
  border-color #eeeeee
  border-style solid
  border-width 0
  box-sizing border-box

html, :host
  font-family t, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif
  font-feature-settings normal
  font-variation-settings 'wght' 400
  font-weight 400
  line-height 1.75
  text-rendering optimizeLegibility
  -webkit-tap-highlight-color transparent
  -webkit-text-size-adjust 100%
  background #ffffff
  color #111111

body
  margin 0
  line-height inherit
  background #ffffff
  color #111111
  min-height 100vh

code, kbd, samp, pre, .mono
  font-family c, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace
  font-size 0.95em

p code, li code, td code
  margin 0 4px

a
  color #0969da
  text-decoration none
  transition color 0.15s ease
  &:hover
    text-decoration underline

::selection
  background #bae6fd
  color #0c4a6e

.wrap
  width 100%
  max-width 980px
  margin 0 auto
  padding 0 20px
  box-sizing border-box
  display flex
  flex-direction column

@media (max-width 640px)
  .wrap
    padding 0 16px

button, select
  font-family inherit
  font-size 100%

summary
  list-style none
  &::-webkit-details-marker
    display none

/* 统一复用组件样式 */
.btn-pill
  display inline-flex
  align-items center
  justify-content center
  gap 6px
  height 32px
  padding 0 12px
  border 1px solid #d0d7de
  background #ffffff
  color #1f2328 !important
  border-radius 6px
  font-size 13px
  font-weight 500
  cursor pointer
  text-decoration none !important
  transition all 0.15s ease
  box-sizing border-box
  white-space nowrap
  &:hover
    background #f6f8fa
    border-color #afb8c1
  &:active
    background #eaeef2

.section-head
  text-align center
  max-width 780px
  margin 0 auto 36px

.section-head h2
  font-size 30px
  font-weight 800
  color #1f2328
  letter-spacing -0.02em
  margin 0 0 10px

.section-head p
  font-size 15px
  color #656d76
  line-height 1.6
  margin 0

/* ═══ 全局复用 UI 基础设施 ═══ */

/* 通用按钮 */
.btn
  display inline-flex
  align-items center
  justify-content center
  gap 6px
  padding 6px 14px
  border-radius 6px
  font-size 13px
  font-weight 600
  cursor pointer
  transition all 0.15s ease
  border 1px solid transparent
  box-sizing border-box
  white-space nowrap
  text-decoration none
  &:disabled
    opacity 0.5
    cursor not-allowed

.btn-primary
  background #0969da
  color #ffffff !important
  border-color #0969da
  &:hover:not(:disabled)
    background #085cc0
    border-color #085cc0

.btn-secondary
  background #f6f8fa
  color #1f2328 !important
  border-color #d0d7de
  &:hover:not(:disabled)
    background #eaeef2
    border-color #afb8c1

.btn-ghost
  background transparent
  color #57606a !important
  border-color transparent
  &:hover:not(:disabled)
    color #1f2328 !important
    background #eaeef2

/* 卡片容器 */
.box-card
  background #ffffff
  border 1px solid #d0d7de
  border-radius 10px
  box-shadow 0 1px 3px rgba(31, 35, 40, 0.04)
  overflow hidden
  transition transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease

.box-card-hover:hover
  transform translateY(-1px)
  border-color #0969da
  box-shadow 0 4px 12px rgba(9, 105, 218, 0.08)

/* 代码面板头部 */
.pane-head
  display flex
  align-items center
  padding 9px 16px
  background #f6f8fa
  border-bottom 1px solid #d0d7de
  font-size 12px
  font-family c, ui-monospace, monospace
  color #57606a
  gap 8px
  .label
    font-weight 600

/* 标准静态代码展示面板 */
.code-pane
  background #ffffff
  border 1px solid #d0d7de
  border-radius 10px
  box-shadow 0 2px 10px rgba(140, 149, 159, 0.08)
  overflow hidden

.code-pane-code
  margin 0
  padding 20px 22px
  font-family c, ui-monospace, monospace
  font-size 13px
  line-height 1.6
  background #ffffff
  color #1f2328
  overflow-x auto
  white-space pre

/* 语法高亮 Token */
.tok-com
  color #57606a
  font-style italic

.tok-kw
  color #0550ae
  font-weight 600

.tok-ty
  color #8250df
  font-weight 600

.tok-str
  color #0a6c2f

.tok-fn
  color #6639ba
  font-weight 600

/* 状态标签 */
.status-pill
  font-size 11px
  padding 2px 8px
  border-radius 10px
  font-weight 600
  display inline-flex
  align-items center

.status-ready
  background #ddf4ff
  color #0969da

.status-running
  background #fff8c5
  color #9a6700

.status-error
  background #ffebe9
  color #cf222e

.status-loading
  background #f6f8fa
  color #57606a

/* 胶囊微徽标 */
.badge-pill
  display inline-flex
  align-items center
  padding 4px 12px
  font-size 12px
  font-weight 600
  color #57606a
  background transparent
  border 1px solid #d0d7de
  border-radius 20px
  letter-spacing -0.01em
  width fit-content
  transition color 0.15s ease, border-color 0.15s ease
  &:hover
    color #1f2328
    border-color #8c959f

/* 文字下划线外链 */
.text-link, .luau-link, .crate-link
  color #0969da
  font-weight 600
  text-decoration none
  border-bottom 1px solid rgba(9, 105, 218, 0.25)
  transition color 0.15s ease, border-color 0.15s ease
  &:hover
    color #0550ae
    border-color #0550ae



